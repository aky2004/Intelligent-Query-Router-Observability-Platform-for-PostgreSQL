# Database
PRIMARY_DATABASE_URL=postgresql://user:pass@primary:5432/db
REPLICA_DATABASE_URLS=["postgresql://user:pass@replica1:5432/db"]

# Set to true to run entirely against simulated in-memory database nodes
SIMULATE_DB=false

# Redis (optional, in-memory fallback used when not available)
REDIS_URL=redis://localhost:6379

# AWS Bedrock / DeepSeek AI
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BEDROCK_MODEL_ID=deepseek.v3.2

# Other AI APIs
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_MODEL=gemini-1.5-flash

# App & Ports
PORT=3000
PG_PROXY_PORT=5433
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=change-me-in-production
CORS_ORIGIN=*

# Thresholds
SLOW_QUERY_THRESHOLD_MS=100
REPLICA_LAG_THRESHOLD_MS=1000
ANOMALY_DETECTION_WINDOW=1000
HEALTH_CHECK_INTERVAL_MS=5000
RATE_LIMIT_PER_MINUTE=100

# Replay
CAPTURE_DIR=./captures

# Supabase Auth
SUPABASE_URL=https://audtuvexejqddwaqjjkf.supabase.co
SUPABASE_ANON_KEY=sb_publishable_X8DuabHaUmOXAhd9bGxL2A_xxwKl7Yp

# Local testing — skips auth in dev
AUTH_DISABLED=true
